# Copy this file to .env and fill in real values. Never commit .env to Git.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset in development to use SQLite.
# Production example:
# DATABASE_URL=postgres://documentlab:password@localhost:5432/documentlab

# Identity-document data is deleted this many days after analysis.
DOCUMENT_RETENTION_DAYS=30
# Only needed if Tesseract isn't on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Production (see docs/DEPLOYMENT.md) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://documentlab.yourschool.local
# DJANGO_BEHIND_HTTPS_PROXY=true       # when Caddy (or another HTTPS proxy) is in front
# DJANGO_ALLOW_HTTP=true               # ONLY for trying production mode on one PC; never with other users
# SESSION_IDLE_MINUTES=30
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# BACKUP_DIR=D:\DocumentLabBackups
# BACKUP_KEEP=14

# --- SSN verification provider (only if your organisation is authorised; see docs/SECURITY.md) ---
# SSN_VERIFICATION_PROVIDER=adapters.myprovider.MyProvider
